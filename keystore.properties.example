# Release signing credentials — copy this file to `keystore.properties` and fill
# in the real values. `keystore.properties` is git-ignored and must NEVER be
# committed. As an alternative to this file, the build also reads the values
# from the environment variables shown in parentheses (useful for CI):
#
#   storePassword  (CTT_STORE_PASSWORD)
#   keyAlias       (CTT_KEY_ALIAS)
#   keyPassword    (CTT_KEY_PASSWORD)
#
# The release keystore itself (release-keystore.jks) is also git-ignored.

storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
